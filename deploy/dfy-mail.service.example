# Install after creating the dedicated dfy user, /srv/dfy venv and writable
# /srv/dfy/memory and /srv/dfy/log directories owned by dfy (mode 0700).
# /etc/dfy/dfy.env is root-owned mode 0600; supply credentials there, never here.
# Intended for a 2-core / 2-GB host. One receive worker per mailbox only.
[Unit]
Description=DFY mail reply and proactive scheduler
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=dfy
Group=dfy
WorkingDirectory=/srv/dfy
EnvironmentFile=/etc/dfy/dfy.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=DFY_LOG_DIR=/srv/dfy/log/output_log
ExecStart=/srv/dfy/.venv/bin/python -B /srv/dfy/src/dfy_clock.py
Restart=on-failure
RestartSec=30s
KillSignal=SIGINT
TimeoutStopSec=120s
StandardOutput=journal
StandardError=journal
UMask=0077
MemoryHigh=768M
MemoryMax=1G
CPUQuota=100%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/dfy/memory /srv/dfy/log

[Install]
WantedBy=multi-user.target
